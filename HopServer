local function enableDrag(handleObj, targetObj, onTapCallback)
	local dragging = false
	local moved = false
	local dragStart = Vector2.zero
	local startPos = UDim2.new()

	trackConn(handleObj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = targetObj.Position
		end
	end))

	trackConn(handleObj.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and not moved and onTapCallback then
				onTapCallback()
			end
			dragging = false
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local cur = Vector2.new(input.Position.X, input.Position.Y)
			local delta = cur - dragStart
			if delta.Magnitude > 5 then
				moved = true
			end
			local newX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, screenGui.AbsoluteSize.X - targetObj.AbsoluteSize.X))
			local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, screenGui.AbsoluteSize.Y - targetObj.AbsoluteSize.Y))
			targetObj.Position = UDim2.fromOffset(newX, newY)
		end
	end))
end

