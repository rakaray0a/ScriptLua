trackConn(UserInputService.InputChanged:Connect(function(input)
	if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local cur = Vector2.new(input.Position.X, input.Position.Y)
		local delta = cur - resizeStart
		local w = math.clamp(startSize.X + delta.X, MIN_W, MAX_W)
		local h = math.clamp(startSize.Y + delta.Y, MIN_H, MAX_H)
		mainFrame.Size = UDim2.fromOffset(w, h)
	end
end))

-- ==========================================
-- 7. AUTO-REFRESH LOOP
-- ==========================================
refreshServers()

task.spawn(function()
	while active do
		task.wait(15)
		if active and mainFrame.Visible and not isRefreshing then
			refreshServers()
		end
	end
end)SoundShimService
