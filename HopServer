-- ==========================================
-- 2. VISITED SERVERS + PERSISTENCE + RESET
-- ==========================================
local SAVE_FILE = "blubub_visited_servers_" .. tostring(PLACE_ID) .. ".json"
local visitedServers = {}

local hasFileSystem = (type(isfile) == "function") and (type(readfile) == "function") and (type(writefile) == "function")

local function saveVisited()
	if not hasFileSystem then
		return
	end
	pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode(visitedServers))
	end)
end

local function loadVisited()
	table.clear(visitedServers)
	if hasFileSystem then
		pcall(function()
			if isfile(SAVE_FILE) then
				local raw = readfile(SAVE_FILE)
				local decoded = HttpService:JSONDecode(raw)
				if type(decoded) == "table" then
					for k, v in pairs(decoded) do
						if v == true then
							visitedServers[tostring(k)] = true
						end
					end
				end
			end
		end)
	end
	if CURRENT_JOB_ID ~= "LOCAL_INSTANCE" then
		visitedServers[CURRENT_JOB_ID] = true
		saveVisited()
	end
end

local function markVisited(jobId)
	if type(jobId) == "string" and jobId ~= "" then
		visitedServers[jobId] = true
		saveVisited()
	end
end

local function isVisited(jobId)
	return visitedServers[tostring(jobId)] == true
end

local function resetVisited()
	table.clear(visitedServers)
	if CURRENT_JOB_ID ~= "LOCAL_INSTANCE" then
		visitedServers[CURRENT_JOB_ID] = true
	end
	saveVisited()
end

loadVisited()

-- ==========================================
-- 3. REALTIME SERVER FETCHER & SORT ASCENDING
-- ==========================================
local function doHttpGet(url)
	local reqFunc = (type(request) == "function" and request)
		or (type(http_request) == "function" and http_request)
		or (syn and type(syn.request) == "function" and syn.request)

	if reqFunc then
		local ok, res = pcall(function()
			return reqFunc({
				Url = url,
				Method = "GET",
				Headers = {
					["Accept"] = "application/json",
					["User-Agent"] = "Mozilla/5.0"
				}
			})
		end)
		if ok and type(res) == "table" and type(res.Body) == "string" then
			return true, res.Body
		end
	end

	local ok2, body2 = pcall(function()
		return game:HttpGet(url)
	end)
	if ok2 and type(body2) == "string" then
		return true, body2
	end

	return false, "HTTP request tidak didukung / diblokir"
end

local function sortServersLowestPlayers(list)
	table.sort(list, function(a, b)
		local pA = tonumber(a.Playing) or 0
		local pB = tonumber(b.Playing) or 0
		if pA ~= pB then
			return pA < pB
		end
		local pingA = tonumber(a.Ping) or math.huge
		local pingB = tonumber(b.Ping) or math.huge
		if pingA ~= pingB then
			return pingA < pingB
		end
		return tostring(a.JobId) < tostring(b.JobId)
	end)
	return list
end

local function fetchRealtimeServers(cursor)
	local baseUrl = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
		PLACE_ID,
		(cursor and cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or "")
	)

	local ok, rawBody = doHttpGet(baseUrl)
	if not ok then
		return nil, tostring(rawBody)
	end

	local decOk, data = pcall(function()
		return HttpService:JSONDecode(rawBody)
	end)
	if not decOk or type(data) ~= "table" or type(data.data) ~= "table" then
		return nil, "Gagal memparse JSON server"
	end

	local list = {}
	for _, srv in ipairs(data.data) do
		if type(srv) == "table" and type(srv.id) == "string" then
			table.insert(list, {
				JobId = srv.id,
				Playing = tonumber(srv.playing) or 0,
				MaxPlayers = tonumber(srv.maxPlayers) or Players.MaxPlayers,
				Ping = tonumber(srv.ping) or 0,
				Fps = tonumber(srv.fps) or 0
			})
		end
	end

	sortServersLowestPlayers(list)
	return list, data.nextPageCursor
end

