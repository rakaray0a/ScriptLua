local function createCard(srv, orderIdx)
	local jobId = tostring(srv.JobId)
	local playing = tonumber(srv.Playing) or 0
	local maxPlayers = tonumber(srv.MaxPlayers) or 20
	local ping = tonumber(srv.Ping) or 0
