	local visited = isVisited(jobId)

	if onlyUnvisited and visited and not isCurrent then
		return
	end

	local card = Instance.new("Frame")
	card.Name = "Card_" .. tostring(orderIdx)
	card.Size = UDim2.new(1, -4, 0, 56)
	card.LayoutOrder = orderIdx
	card.BackgroundColor3 = visited and C_CARD_VISITED or C_CARD
	card.BorderSizePixel = 0
	card.Parent = scrollList

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 9)
	cardCorner.Parent = card

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = isCurrent and C_ACCENT or (visited and C_SUCCESS or C_BORDER)
	cardStroke.Thickness = (isCurrent or visited) and 1.2 or 0.8
	cardStroke.Parent = card

	local badgeText = visited and "SUDAH MASUK" or "BELUM MASUK"
	local badgeColor = visited and C_SUCCESS or C_MUTED
	if isCurrent then
		badgeText = "SERVER SAAT INI"
		badgeColor = C_ACCENT
	end

	local statusTag = Instance.new("TextLabel")
	statusTag.Size = UDim2.new(1, -104, 0, 16)
	statusTag.Position = UDim2.fromOffset(10, 6)
	statusTag.BackgroundTransparency = 1
	statusTag.Text = "● " .. badgeText .. string.format("   |   %d/%d Players   |   %dms", playing, maxPlayers, ping)
	statusTag.TextColor3 = badgeColor
	statusTag.Font = Enum.Font.GothamBold
	statusTag.TextSize = 11
	statusTag.TextXAlignment = Enum.TextXAlignment.Left
	statusTag.TextTruncate = Enum.TextTruncate.AtEnd
	statusTag.Parent = card

	local idLabel = Instance.new("TextLabel")
	idLabel.Size = UDim2.new(1, -104, 0, 18)
	idLabel.Position = UDim2.fromOffset(10, 26)
	idLabel.BackgroundTransparency = 1
	idLabel.Text = "JobId: " .. jobId
	idLabel.TextColor3 = C_TEXT
	idLabel.Font = Enum.Font.Code
	idLabel.TextSize = 11
	idLabel.TextXAlignment = Enum.TextXAlignment.Left
	idLabel.TextTruncate = Enum.TextTruncate.AtEnd
	idLabel.Parent = card

	local joinBtn = Instance.new("TextButton")
	joinBtn.Size = UDim2.fromOffset(82, 36)
	joinBtn.Position = UDim2.new(1, -90, 0.5, -18)
	joinBtn.BackgroundColor3 = isCurrent and C_BORDER or C_SUCCESS
	joinBtn.Text = isCurrent and "Current" or "Join"
	joinBtn.TextColor3 = isCurrent and C_MUTED or Color3.fromRGB(10, 20, 15)
	joinBtn.Font = Enum.Font.GothamBold
	joinBtn.TextSize = 12
	joinBtn.Active = not isCurrent
	joinBtn.Parent = card

	local joinCorner = Instance.new("UICorner")
	joinCorner.CornerRadius = UDim.new(0, 8)
	joinCorner.Parent = joinBtn

	trackConn(joinBtn.MouseButton1Click:Connect(function()
		if isCurrent or jobId == "" then
			return
		end
		markVisited(jobId)
		joinBtn.Text = "Hopping..."
		joinBtn.BackgroundColor3 = C_ACCENT
		joinBtn.TextColor3 = Color3.fromRGB(10, 15, 25)
		statusBar.Text = "Teleport ke JobId: " .. jobId

		local ok, err = pcall(function()
			TeleportService:TeleportToPlaceInstance(PLACE_ID, jobId, player)
		end)

		if not ok then
			statusBar.Text = "Gagal hop: " .. tostring(err)
			joinBtn.Text = "Join"
			joinBtn.BackgroundColor3 = C_SUCCESS
			joinBtn.TextColor3 = Color3.fromRGB(10, 20, 15)
			renderCards()
		end
	end))
end

function renderCards()
	sortServersLowestPlayers(cachedServers)
	clearCards()
	local shown = 0
	for idx, srv in ipairs(cachedServers) do
		createCard(srv, idx)
		shown += 1
	end
	statusBar.Text = string.format("Sort: Terkecil | Servers: %d (Tampil: %d)", #cachedServers, shown)
end

local function refreshServers()
	if isRefreshing or not active then
		return
	end
	isRefreshing = true
	refreshBtn.Text = "..."
	statusBar.Text = "Mengambil daftar server (terkecil ke terbesar)..."

	task.spawn(function()
		local list, errOrCursor = fetchRealtimeServers(nil)
		if not active then
			return
		end
		if list then
			cachedServers = list
			renderCards()
		else
			statusBar.Text = "Error fetch: " .. tostring(errOrCursor)
		end
		refreshBtn.Text = "⟳ Refresh"
		isRefreshing = false
	end)
end

