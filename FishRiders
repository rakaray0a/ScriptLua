    scrollingPumpkins.Visible = (activeTab == "Pumpkins")
    scrollingKalolo.Visible = (activeTab == "Kalolo")
    scrollingGolem.Visible = (activeTab == "Golem")
    scrollingHome.Visible = (activeTab == "HOME")
    scrollingSpectate.Visible = (activeTab == "Spectate")
    scrollingServer.Visible = (activeTab == "S.Hop")

    local tabs = {
        {btn = btnTabEggs, name = "Eggs"},
        {btn = btnTabPumpkins, name = "Pumpkins"},
        {btn = btnTabKalolo, name = "Kalolo"},
        {btn = btnTabGolem, name = "Golem"},
        {btn = btnTabHome, name = "HOME"},
        {btn = btnTabSpectate, name = "Spectate"},
        {btn = btnTabServer, name = "S.Hop"}
    }

    for _, t in ipairs(tabs) do
