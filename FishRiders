	renderConn = RunService.RenderStepped:Connect(function()
		if not model or not model.Parent then
			if renderConn then renderConn:Disconnect() end
			return
		end
		
		local currentCf = model:GetPivot()
		if currentCf.Position.Magnitude > 0 then
			anchorPart.CFrame = currentCf
		end

		if billboard.Enabled and textLabel.Visible and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
