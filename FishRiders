-- Logika Utama Spectator (Auto-Lock Arah Depan, Zoom, & Dynamic Streaming Force Render)
table.insert(activeConnections, RunService.RenderStepped:Connect(function()
    local targetP = getgenv().SpectatingPlayer
    if targetP and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") then
        local tHrp = targetP.Character.HumanoidRootPart
        
        -- Paksa server me-render area di sekitar target yang sedang di-spectate (Bypass Streaming Jarak Jauh)
        pcall(function()
            Workspace:RequestStreamAsync(tHrp.Position)
        end)

        camera.CameraType = Enum.CameraType.Scriptable

        -- Kamera mengunci ke belakang player target menghadap ke arah depan (LookVector) sesuai zoom
        local targetPos = tHrp.Position
        local lookVector = tHrp.CFrame.LookVector
        
        -- Posisikan kamera di belakang player target dengan jarak zoom yang disesuaikan
        local camPos = targetPos - (lookVector * getgenv().SpectateZoom) + Vector3.new(0, getgenv().SpectateZoom * 0.4, 0)
        
        camera.CFrame = CFrame.new(camPos, targetPos + Vector3.new(0, 2, 0))
    end
end))
