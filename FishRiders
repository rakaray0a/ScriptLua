local function updateESPVisibility()
	for model, espData in pairs(activeESPs) do
		if espData.AnchorPart and espData.AnchorPart.Parent then
			local eggName = espData.EggName
			local isEnabled = (eggFilters[eggName] == true)
			if espData.Billboard then espData.Billboard.Enabled = isEnabled end
			if espData.TextLabel then espData.TextLabel.Visible = isEnabled end
		end
	end
end

