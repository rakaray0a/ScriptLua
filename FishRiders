local visitedFileName = "MultiHub_VisitedServers.json"
local function loadVisited()
    if isfile and readfile and isfile(visitedFileName) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(visitedFileName)) end)
        if success and type(result) == "table" then return result end
    end
    return {}
end
local function saveVisited(tbl)
    if writefile then
        pcall(function() writefile(visitedFileName, HttpService:JSONEncode(tbl)) end)
    end
end

