local function fullCleanup()
	for _, conn in ipairs(activeConnections) do
		if typeof(conn) == "RBXScriptConnection" then
			conn:Disconnect()
		end
	end
	for _, espData in pairs(activeESPs) do
		if espData.Connection then espData.Connection:Disconnect() end
		if espData.Billboard then espData.Billboard:Destroy() end
		if espData.AnchorPart then espData.AnchorPart:Destroy() end
	end
	for _, btn in pairs(eggUiButtons) do
		if btn then btn:Destroy() end
	end
	for _, espData in pairs(activePumpkinESPs) do
		if espData.Connection then espData.Connection:Disconnect() end
		if espData.Billboard then espData.Billboard:Destroy() end
		if espData.UiButton then espData.UiButton:Destroy() end
		if espData.AnchorPart then espData.AnchorPart:Destroy() end
	end
	for _, espData in pairs(activeKaloloESPs) do
		if espData.Connection then espData.Connection:Disconnect() end
		if espData.Billboard then espData.Billboard:Destroy() end
		if espData.UiButton then espData.UiButton:Destroy() end
		if espData.AnchorPart then espData.AnchorPart:Destroy() end
	end
	table.clear(activeESPs)
	table.clear(eggUiButtons)
	table.clear(activePumpkinESPs)
	table.clear(activeKaloloESPs)
	
	-- Kembalikan kamera ke player sendiri jika sedang spectate
	camera.CameraType = Enum.CameraType.Custom
	if player.Character and player.Character:FindFirstChild("Humanoid") then
		camera.CameraSubject = player.Character.Humanoid
	end

	if screenGui then
		screenGui:Destroy()
	end
end
getgenv().MultiHubESPLoaded = fullCleanup

--// Fungsi Helper Teleport
local function teleportToTarget(target)
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local targetCf = nil
	if typeof(target) == "Instance" then
		if target:IsA("Model") then
			targetCf = target:GetPivot()
		elseif target:IsA("BasePart") then
			targetCf = target.CFrame
		end
	elseif typeof(target) == "CFrame" then
		targetCf = target
	end

	if targetCf then
		hrp.CFrame = targetCf + Vector3.new(0, 3, 0)
	end
end

--// Fungsi Warna Konsisten untuk Eggs
local function getEggColor(name)
	local hash = 0
	for i = 1, #name do
		hash = hash + string.byte(name, i)
	end
	local colorPalette = {
		Color3.fromRGB(0, 255, 170),   -- Neon Teal
		Color3.fromRGB(255, 80, 150),  -- Hot Pink
		Color3.fromRGB(255, 170, 0),   -- Neon Orange
		Color3.fromRGB(140, 80, 255),  -- Electric Purple
		Color3.fromRGB(50, 180, 255),  -- Electric Blue
		Color3.fromRGB(255, 230, 0),   -- Bright Yellow
		Color3.fromRGB(0, 255, 100),   -- Neon Green
		Color3.fromRGB(255, 90, 90)    -- Bright Red
	}
	return colorPalette[(hash % #colorPalette) + 1]
end

