		{btn = btnTabEggs, name = "Eggs"},
		{btn = btnTabPumpkins, name = "Pumpkins"},
		{btn = btnTabKalolo, name = "Kalolo"},
		{btn = btnTabHome, name = "HOME"},
		{btn = btnTabSpectate, name = "Spectate"}
	}

	for _, t in ipairs(tabs) do
		if t.name == activeTab then
			t.btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			t.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			t.btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			t.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		end
	end
end

