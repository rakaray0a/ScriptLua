    task.spawn(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, srv in ipairs(result.data) do
                if srv.id ~= game.JobId then
                    local isVisited = getgenv().VisitedServers[srv.id]
                    
                    local srvBtn = Instance.new("TextButton")
                    srvBtn.Size = UDim2.new(1, 0, 0, 28)
                    srvBtn.TextSize, srvBtn.Font = 10, Enum.Font.GothamBold
                    Instance.new("UICorner", srvBtn).CornerRadius = UDim.new(0, 6)
                    
                    if isVisited then
                        srvBtn.BackgroundColor3 = Color3.fromRGB(120, 60, 20)
                        srvBtn.Text = "Join: " .. srv.playing .. "/" .. srv.maxPlayers .. " [SUDAH VISITED]"
                        srvBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                    else
                        srvBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 150)
                        srvBtn.Text = "Join: " .. srv.playing .. "/" .. srv.maxPlayers
                        srvBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end
                    
                    srvBtn.MouseButton1Click:Connect(function()
                        getgenv().VisitedServers[srv.id] = true
                        saveVisited(getgenv().VisitedServers)
                        srvBtn.Text = "Teleporting..."
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                    end)
                    
                    srvBtn.Parent = scrollingServer
                    table.insert(dynamicServerBtns, {button = srvBtn, id = srv.id, playing = srv.playing, max = srv.maxPlayers})
                end
            end
            loadServersBtn.Text = "⬇ Refresh Daftar Server ⬇"
        else
            loadServersBtn.Text = "Gagal Memuat! (Klik Untuk Coba Lagi)"
        end
    end)
end

