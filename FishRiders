--// --- ESP 1: WILD EGGS (PERSISTENT & AUTO REMOVE) ---
local function updateESPVisibility()
	for model, espData in pairs(activeESPs) do
		if model and model.Parent then
			local eggName = espData.EggName
			local isEnabled = (eggFilters[eggName] == true)
			if espData.Highlight then espData.Highlight.Enabled = isEnabled end
			if espData.Billboard then espData.Billboard.Enabled = isEnabled end
			if espData.TextLabel then espData.TextLabel.Visible = isEnabled end
		end
	end
end

local function createToggleUI(eggName)
	if eggUiButtons[eggName] ~= nil then return end
	if eggFilters[eggName] == nil then
		eggFilters[eggName] = true
	end

	local eggColor = getEggColor(eggName)
	local toggleButton = Instance.new("TextButton")
	toggleButton.Size = UDim2.new(1, 0, 0, 32)
	toggleButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	toggleButton.Text = ""
	toggleButton.AutoButtonColor = false
	toggleButton.Parent = scrollingEggs
	Instance.new("UICorner", toggleButton).CornerRadius = UDim.new(0, 6)

	local checkIndicator = Instance.new("TextLabel")
	checkIndicator.Size = UDim2.new(0, 25, 1, 0)
	checkIndicator.Position = UDim2.new(0, 5, 0, 0)
	checkIndicator.BackgroundTransparency = 1
	checkIndicator.Text = eggFilters[eggName] and "✔" or ""
	checkIndicator.TextColor3 = eggFilters[eggName] and eggColor or Color3.fromRGB(120, 120, 120)
	checkIndicator.TextSize, checkIndicator.Font = 14, Enum.Font.GothamBold
	checkIndicator.Parent = toggleButton

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -35, 1, 0)
	nameLabel.Position = UDim2.new(0, 32, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = tostring(eggName)
	nameLabel.TextColor3 = eggFilters[eggName] and eggColor or Color3.fromRGB(120, 120, 120)
	nameLabel.TextSize, nameLabel.Font = 13, Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = toggleButton

	toggleButton.MouseButton1Click:Connect(function()
		eggFilters[eggName] = not eggFilters[eggName]
		if eggFilters[eggName] then
			checkIndicator.Text = "✔"
			checkIndicator.TextColor3, nameLabel.TextColor3 = eggColor, eggColor
		else
			checkIndicator.Text = ""
			checkIndicator.TextColor3, nameLabel.TextColor3 = Color3.fromRGB(120, 120, 120), Color3.fromRGB(120, 120, 120)
		end
		updateESPVisibility()
	end)

	eggUiButtons[eggName] = toggleButton
end

local function addESP(model)
	if activeESPs[model] then return end
	if not model:IsA("Model") then return end

	local eggName = model.Name
	createToggleUI(eggName)

	local eggColor = getEggColor(eggName)
	local isEnabled = (eggFilters[eggName] == true)

	local highlight = Instance.new("Highlight")
	highlight.Adornee = model
	highlight.FillColor = eggColor
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.Enabled = isEnabled
	highlight.Parent = model

	local targetPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not targetPart then
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") then targetPart = desc break end
		end
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = targetPart
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = isEnabled
	billboard.Parent = model

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = eggColor
	textLabel.TextStrokeTransparency = 0.3
	textLabel.TextSize, textLabel.Font = 12, Enum.Font.GothamBold
	textLabel.Visible = isEnabled
	textLabel.Parent = billboard

	local renderConn
	renderConn = RunService.RenderStepped:Connect(function()
		if not model or not model.Parent or not targetPart then
			if renderConn then renderConn:Disconnect() end
			return
		end
		if billboard.Enabled and textLabel.Visible and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			local distance = math.floor((hrp.Position - targetPart.Position).Magnitude)
			textLabel.Text = eggName .. "\n[" .. distance .. "m]"
		end
	end)

	activeESPs[model] = { Highlight = highlight, Billboard = billboard, TextLabel = textLabel, Connection = renderConn, EggName = eggName }
end

local function removeESP(model)
	if activeESPs[model] then
		local eggName = activeESPs[model].EggName
		if activeESPs[model].Connection then activeESPs[model].Connection:Disconnect() end
		if activeESPs[model].Highlight then activeESPs[model].Highlight:Destroy() end
		if activeESPs[model].Billboard then activeESPs[model].Billboard:Destroy() end
		activeESPs[model] = nil

		local stillExists = false
		for _, data in pairs(activeESPs) do
			if data.EggName == eggName then stillExists = true break end
		end

		if not stillExists then
			if eggUiButtons[eggName] then
				eggUiButtons[eggName]:Destroy()
				eggUiButtons[eggName] = nil
			end
		end
	end
end

for _, child in ipairs(wildEggsFolder:GetChildren()) do addESP(child) end
table.insert(activeConnections, wildEggsFolder.ChildAdded:Connect(function(child) task.wait(0.1); addESP(child) end))
table.insert(activeConnections, wildEggsFolder.ChildRemoved:Connect(function(child) removeESP(child) end))


