local TWEEN_SPEED = 350   -- Kecepatan tween
local COLLECT_DELAY = 1.2 -- Jeda waktu collect setelah hold
local MOBILE_HOLD_TIME = 0.8 -- Durasi simulasi hold E di mobile (detik)

