-- ==========================================
-- FUNGSI AUTO KLIK TOMBOL PICK UP DI MOBILE
-- ==========================================
local function triggerMobilePickUpButton()
	pcall(function()
		for _, gui in ipairs(playerGui:GetDescendants()) do
			if (gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("ImageButton")) then
				if string.find(string.lower(gui.Name), "pick") or (gui:IsA("TextLabel") and string.find(string.lower(gui.Text), "pick up")) then
					local btn = gui:FindFirstAncestorWhichIsA("GuiButton") or gui
					if btn and btn:IsA("GuiButton") then
						if firesignal then
							firesignal(btn.Activated)
							firesignal(btn.MouseButton1Click)
						end
					end
				end
			end
		end
		
		local viewportSize = Workspace.CurrentCamera.ViewportSize
		local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
		
		VirtualInputManager:SendTouchEvent(1, 0, screenCenter.X, screenCenter.Y)
		task.wait(HOLD_TIME)
		VirtualInputManager:SendTouchEvent(1, 1, screenCenter.X, screenCenter.Y)
		VirtualInputManager:SendTouchEvent(1, 2, screenCenter.X, screenCenter.Y)
	end)
end

-- ==========================================
-- SORTING DARI ANGKA TERBESAR KE TERKECIL (Candy_04 ke Candy_01)
-- ==========================================
local function getSortedCandyListByName(folder)
	local items = folder:GetChildren()
	table.sort(items, function(a, b)
		return a.Name > b.Name
	end)
	return items
end

-- ==========================================
-- MAIN LOOP (Teleport Version + Name Sorting + Delays)
-- ==========================================
task.spawn(function()
	while getgenv().CandyMobileFarmRunning do
		task.wait(0.2)
		
		if isRunning then
			local candyFolder = Workspace:FindFirstChild("HalloweenCandy", true)
			local dropOffPad = Workspace:FindFirstChild("Pad", true) or (Workspace:FindFirstChild("CandyDropOff", true) and Workspace:FindFirstChild("CandyDropOff", true):FindFirstChild("Pad", true))
			
			if not candyFolder or not dropOffPad then
				task.wait(2)
				continue
			end
			
			-- Mengambil daftar candy yang diurutkan dari nama/indeks terbesar ke terkecil
			local candyList = getSortedCandyListByName(candyFolder)
			
			for _, candy in ipairs(candyList) do
				if not isRunning or not getgenv().CandyMobileFarmRunning then break end
				
				local targetPart = candy:IsA("BasePart") and candy or (candy:IsA("Model") and (candy.PrimaryPart or candy:FindFirstChildWhichIsA("BasePart", true)))
				
				if targetPart then
					local rootPart = getRootPart()
					if rootPart then
						local candyPos = targetPart.Position
						if candy:IsA("Model") and candy.WorldPivot then
							candyPos = candy:GetPivot().Position
						end
						
						-- 1. Teleport instan ke lokasi candy (dengan jeda stabilisasi)
						teleportTo(CFrame.new(candyPos + Vector3.new(0, 0.5, 0)))
						
						-- 2. Picu tombol "Pick Up" kustom di layar HP
						triggerMobilePickUpButton()
						
						-- TouchInterest cadangan
						pcall(function()
							firetouchinterest(rootPart, targetPart, 0)
							task.wait(0.02)
							firetouchinterest(rootPart, targetPart, 1)
						end)
						
						task.wait(COLLECT_DELAY)
						
						-- 3. Teleport instan ke DropOff Pad (dengan jeda stabilisasi)
						local dropPos = dropOffPad.Position
						teleportTo(CFrame.new(dropPos + Vector3.new(0, 3, 0)))
						
						-- 4. Jeda waktu (delay) saat berada di lokasi drop candy
						task.wait(DROP_DELAY)
					end
				end
			end
			
			task.wait(0.5)
		end
	end
end)
