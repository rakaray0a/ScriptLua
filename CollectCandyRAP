-- PENGATURAN PARAMETER
-- ==========================================
local HOLD_TIME = 1.3       -- Durasi menahan tombol kustom
local COLLECT_DELAY = 0.5   -- Jeda setelah collect
local DROP_DELAY = 1.2      -- Jeda waktu ketika berada di lokasi drop candy
local TELEPORT_DELAY = 0.5  -- Jeda waktu setelah melakukan teleport agar posisi stabil

-- ==========================================
-- SISTEM ANTI-STACK (Mencegah double loop)
-- ==========================================
if getgenv().CandyMobileFarmRunning then
	getgenv().CandyMobileFarmRunning = false
	task.wait(0.3)
end
