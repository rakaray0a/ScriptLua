-- ==========================================
-- PROXIMITY HOLD BINDING KHUSUS MOBILE
-- ==========================================
local function forceMobileProximityHold(prompt)
	if not prompt then return end
	pcall(function()
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 9999
		
		-- 1. Picu event InputHoldBegan (Mulai Menahan)
		if prompt.InputHoldBegan then
			prompt:InputHoldBegan()
		end
		
		-- 2. Tahan sesuai durasi hold game
		task.wait(MOBILE_HOLD_TIME)
		
		-- 3. Picu event InputHoldEnded & Triggered (Selesai Menahan)
		if prompt.InputHoldEnded then
			prompt:InputHoldEnded()
		end
		
		if fireproximityprompt then
			fireproximityprompt(prompt)
		end
	end)
end

local function getSortedCandyList(folder)
	local items = folder:GetChildren()
	table.sort(items, function(a, b)
		return a.Name > b.Name
	end)
	return items
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
task.spawn(function()
	while getgenv().CandyMobileFarmRunning do
		task.wait(0.2)
		
		if isRunning then
			local candyFolder = Workspace:FindFirstChild("HalloweenCandy", true)
			local dropOffPad = Workspace:FindFirstChild("Pad", true) or (Workspace:FindFirstChild("CandyDropOff", true) and Workspace:FindFirstChild("CandyDropOff", true):FindFirstChild("Pad", true))
			
			if not candyFolder or not dropOffPad then
				task.wait(2)
				continue
			end
			
			local candyList = getSortedCandyList(candyFolder)
			
			for _, candy in ipairs(candyList) do
				if not isRunning or not getgenv().CandyMobileFarmRunning then break end
				
				local targetPart = candy:IsA("BasePart") and candy or (candy:IsA("Model") and (candy.PrimaryPart or candy:FindFirstChildWhichIsA("BasePart", true)))
				local prompt = candy:FindFirstChildWhichIsA("ProximityPrompt", true)
				
				if targetPart then
					local rootPart = getRootPart()
					if rootPart then
						local candyPos = targetPart.Position
						if candy:IsA("Model") and candy.WorldPivot then
							candyPos = candy:GetPivot().Position
						end
						
						-- 1. Tween tepat ke lokasi candy
						tweenTo(CFrame.new(candyPos + Vector3.new(0, 0.5, 0)), TWEEN_SPEED)
						task.wait(0.05)
						
						-- 2. Eksekusi Hold Proximity Mobile
						if prompt then
							forceMobileProximityHold(prompt)
						end
						
						-- Sentuhan fisik cadangan (TouchInterest)
						pcall(function()
							firetouchinterest(rootPart, targetPart, 0)
							task.wait(0.02)
							firetouchinterest(rootPart, targetPart, 1)
						end)
						
						task.wait(COLLECT_DELAY)
						
						-- 3. Tween ke DropOff Pad
						local dropPos = dropOffPad.Position
						tweenTo(CFrame.new(dropPos + Vector3.new(0, 3, 0)), TWEEN_SPEED)
						task.wait(0.1)
					end
				end
			end
			
			task.wait(0.5)
		end
	end
end)
