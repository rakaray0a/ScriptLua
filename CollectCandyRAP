-- ==========================================
-- PENGATURAN PARAMETER
-- ==========================================
local TWEEN_SPEED = 400   -- Kecepatan tween
local COLLECT_DELAY = 1.0 -- Jeda waktu setelah collect

-- ==========================================
-- SISTEM ANTI-STACK (Mencegah double loop)
-- ==========================================
if getgenv().CandyUIAutoFarmRunning then
	getgenv().CandyUIAutoFarmRunning = false
	task.wait(0.3)
end
getgenv().CandyUIAutoFarmRunning = true

-- ==========================================
-- KODE UTAMA & UI
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local isRunning = false

local function getRootPart()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:FindFirstChild("HumanoidRootPart")
end

local function tweenTo(targetCFrame, speed)
	local rootPart = getRootPart()
	if not rootPart then return end
	
	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / speed, 0.05)
	
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	task.wait(duration)
end

