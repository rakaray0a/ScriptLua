-- ==========================================
-- FITUR DRAG, MINIMIZE, & RESIZE UI
-- ==========================================
local UserInputService = game:GetService("UserInputService")

local dragging, dragInput, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Minimize Logic
local isMinimized = false
minButton.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	toggleButton.Visible = not isMinimized
	if isMinimized then
		mainFrame.Size = UDim2.new(0, 220, 0, 35)
		minButton.Text = "+"
	else
		mainFrame.Size = UDim2.new(0, 220, 0, 140)
		minButton.Text = "-"
	end
end)

-- Close Logic
closeButton.MouseButton1Click:Connect(function()
	getgenv().CandyUIAutoFarmRunning = false
	screenGui:Destroy()
end)

-- Resize Logic
local resizing = false
resizeButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local mousePos = input.Position
		local newWidth = math.clamp(mousePos.X - mainFrame.AbsolutePosition.X, 180, 400)
		local newHeight = math.clamp(mousePos.Y - mainFrame.AbsolutePosition.Y, 100, 300)
		mainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
	end
end)

-- Toggle Button Aksi
toggleButton.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	if isRunning then
		toggleButton.Text = "STATUS: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleButton.Text = "STATUS: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

-- ==========================================
-- MAIN LOOP AUTO FARM
-- ==========================================
local function getSortedCandyList(folder)
	local items = folder:GetChildren()
	table.sort(items, function(a, b)
		return a.Name > b.Name
	end)
	return items
end

task.spawn(function()
	while getgenv().CandyUIAutoFarmRunning do
		task.wait(0.2)
		
		if isRunning then
			local candyFolder = Workspace:FindFirstChild("HalloweenCandy", true)
			local dropOffPad = Workspace:FindFirstChild("Pad", true) or (Workspace:FindFirstChild("CandyDropOff", true) and Workspace:FindFirstChild("CandyDropOff", true):FindFirstChild("Pad", true))
			
			if not candyFolder or not dropOffPad then
				task.wait(2)
				continue
			end
			
			local candyList = getSortedCandyList(candyFolder)
			
			for _, candy in ipairs(candyList) do
				if not isRunning or not getgenv().CandyUIAutoFarmRunning then break end
				
				local targetPart = nil
				if candy:IsA("BasePart") then
					targetPart = candy
				elseif candy:IsA("Model") then
					targetPart = candy.PrimaryPart or candy:FindFirstChildWhichIsA("BasePart", true)
				end
				
				local prompt = candy:FindFirstChildWhichIsA("ProximityPrompt", true)
				
				if targetPart then
					local rootPart = getRootPart()
					if rootPart then
						local candyPos = targetPart.Position
						if candy:IsA("Model") and candy.WorldPivot then
							candyPos = candy:GetPivot().Position
						end
						
						-- 1. Tween ke posisi candy
						tweenTo(CFrame.new(candyPos + Vector3.new(0, 0.5, 0)), TWEEN_SPEED)
						task.wait(0.05)
						
						-- 2. Bypass Proximity / Hold untuk Mobile & PC secara instan
						if prompt then
							pcall(function()
								prompt.HoldDuration = 0
								prompt.MaxActivationDistance = 9999
								fireproximityprompt(prompt)
							end)
						end
						
						-- Cadangan sentuhan fisik (TouchInterest)
						pcall(function()
							firetouchinterest(rootPart, targetPart, 0)
							task.wait(0.02)
							firetouchinterest(rootPart, targetPart, 1)
						end)
						
						task.wait(COLLECT_DELAY)
						
						-- 3. Tween ke DropOff Pad
						local dropPos = dropOffPad.Position
						tweenTo(CFrame.new(dropPos + Vector3.new(0, 3, 0)), TWEEN_SPEED)
						task.wait(0.1)
					end
				end
			end
			
			task.wait(0.5)
		end
	end
end)
