-- ==========================================
-- PENGATURAN PARAMETER
-- ==========================================
local TWEEN_SPEED = 350   -- Kecepatan tween
local COLLECT_DELAY = 1.2 -- Jeda waktu collect (detik)

-- ==========================================
-- SISTEM ANTI-STACK
-- ==========================================
if getgenv().CandyMobileFarmRunning then
	getgenv().CandyMobileFarmRunning = false
	task.wait(0.3)
end
getgenv().CandyMobileFarmRunning = true

-- ==========================================
-- KODE UTAMA & MOBILE BINDING
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local isRunning = false

-- Simulasi Klik / Sentuh Layar Otomatis untuk Mobile
player.Idled:Connect(function()
	VirtualUser:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
	task.wait(1)
	VirtualUser:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
end)

local function getRootPart()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:FindFirstChild("HumanoidRootPart")
end

local function tweenTo(targetCFrame, speed)
	local rootPart = getRootPart()
	if not rootPart then return end
	
	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / speed, 0.05)
	
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	task.wait(duration)
end

