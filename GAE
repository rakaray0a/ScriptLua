local function createESP(eggModel, isNewSpawn)
    if not targetEggs[eggModel.Name] then return end
    if espFolder:FindFirstChild(eggModel.Name .. "_" .. eggModel:GetDebugId()) then return end

    local adorneePart = (eggModel:IsA("Model") and (eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart", true))) or (eggModel:IsA("BasePart") and eggModel)
    if not adorneePart then return end

    -- Daftarkan ke Active list untuk sistem Radar
    activeEggInstances[eggModel] = true

    -- Mainkan Notifikasi HANYA jika ini telur yang baru spawn (bukan bawaan map awal)
    if isNewSpawn then
        showNotification(eggModel.Name)
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = eggModel.Name .. "_" .. eggModel:GetDebugId()
    billboard.Adornee = adorneePart
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = espEnabled
    billboard.Parent = espFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = eggModel.Name
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = billboard

    if eggModel.Name == "Time Egg" then textLabel.TextColor3 = Color3.fromRGB(85, 255, 255)
    elseif eggModel.Name == "Galaxy Egg" then textLabel.TextColor3 = Color3.fromRGB(170, 0, 255)
    elseif eggModel.Name == "Phoenix Egg" then textLabel.TextColor3 = Color3.fromRGB(255, 85, 0)
    else textLabel.TextColor3 = Color3.fromRGB(255, 255, 0) end 

    local ancConnection = eggModel.AncestryChanged:Connect(function(_, parent)
        if not parent then 
            billboard:Destroy() 
            activeEggInstances[eggModel] = nil -- Hapus dari sistem radar
        end
    end)
    table.insert(connections, ancConnection)
end

local function scanAllExisting()
    local gameplayRuntime = Workspace:FindFirstChild("GameplayRuntime")
    local activeEggsFolder = gameplayRuntime and gameplayRuntime:FindFirstChild("ActiveEggs")
    if activeEggsFolder then
        for _, obj in pairs(activeEggsFolder:GetDescendants()) do
            createESP(obj, false) -- isNewSpawn = false (Jangan bunyikan notif saat load map)
        end
    end
end

task.spawn(function()
    local gameplayRuntime = Workspace:WaitForChild("GameplayRuntime", 10)
    local activeEggsFolder = gameplayRuntime and gameplayRuntime:WaitForChild("ActiveEggs", 10)
    if activeEggsFolder then
        scanAllExisting()
        local descConnection = activeEggsFolder.DescendantAdded:Connect(function(newObj)
            task.delay(0.1, function() createESP(newObj, true) end) -- isNewSpawn = true (Bunyikan notif!)
        end)
        table.insert(connections, descConnection)
    end
end)

