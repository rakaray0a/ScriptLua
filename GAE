local function fetchServers()
    for _, child in pairs(serverScroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            local count = 0
            for _, srv in pairs(data.data) do
                if srv.playing and srv.maxPlayers and srv.id ~= game.JobId then
                    count = count + 1
                    local srvItem = Instance.new("Frame")
                    srvItem.Size = UDim2.new(1, 0, 0, 30); srvItem.BackgroundColor3 = Color3.fromRGB(40, 40, 40); srvItem.BorderSizePixel = 0; srvItem.Parent = serverScroll
                    Instance.new("UICorner", srvItem).CornerRadius = UDim.new(0, 4)

                    local isVisited = visitedServers[srv.id] or false
                    local srvText = Instance.new("TextLabel")
                    srvText.Size = UDim2.new(0.7, -5, 1, 0); srvText.Position = UDim2.new(0, 5, 0, 0); srvText.BackgroundTransparency = 1
                    srvText.Text = "Players: " .. srv.playing .. "/" .. srv.maxPlayers .. (isVisited and " (Visited)" or "")
                    srvText.TextColor3 = isVisited and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(255, 255, 255)
                    srvText.Font = Enum.Font.Gotham; srvText.TextSize = 12; srvText.TextXAlignment = Enum.TextXAlignment.Left; srvText.Parent = srvItem

                    local joinBtn = Instance.new("TextButton")
                    joinBtn.Size = UDim2.new(0.3, -5, 0, 24); joinBtn.Position = UDim2.new(0.7, 0, 0, 3)
                    joinBtn.BackgroundColor3 = isVisited and Color3.fromRGB(139, 0, 0) or Color3.fromRGB(46, 204, 113)
                    joinBtn.Text = "Join"; joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255); joinBtn.Font = Enum.Font.GothamBold; joinBtn.TextSize = 12; joinBtn.Parent = srvItem
                    Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 4)

                    joinBtn.MouseButton1Click:Connect(function()
                        joinBtn.Text = "Joining..."
                        visitedServers[srv.id] = true; saveData(SERVER_SAVE_FILE, visitedServers)
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, localPlayer)
                    end)
                end
            end
            serverScroll.CanvasSize = UDim2.new(0, 0, 0, count * 35)
        end
    end
end
refreshSrvBtn.MouseButton1Click:Connect(function() refreshSrvBtn.Text = "Fetching..."; fetchServers(); refreshSrvBtn.Text = "Refresh List" end)
resetSrvBtn.MouseButton1Click:Connect(function() visitedServers = { [game.JobId] = true }; saveData(SERVER_SAVE_FILE, visitedServers); fetchServers() end)

