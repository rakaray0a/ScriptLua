        -- Pastikan telur belum dihancurkan (valid) dan nama telur masih ada di list
        if egg.Parent and targetEggs[egg.Name] then
            local eggPos = (egg:IsA("Model") and egg.PrimaryPart and egg.PrimaryPart.Position) or (egg:IsA("BasePart") and egg.Position) or egg:GetModelCFrame().Position
            
            -- Konversi koordinat Object (Egg) relatif terhadap arah hadap Kamera
            local rel = cam.CFrame:PointToObjectSpace(eggPos)
            
            -- X adalah Kanan(+)/Kiri(-), Z adalah Belakang(+)/Depan(-)
            -- Kita memproyeksikannya ke radar datar (math.atan2)
            local angle = math.atan2(rel.Z, rel.X)
            
            -- Hitung posisi panah mengelilingi titik tengah radar dengan jari-jari 50
            local radius = 50 
            local x = math.cos(angle) * radius
            local y = math.sin(angle) * radius
            
            -- Buat atau gunakan kembali TextLabel panah
            local arrow = radarBillboard:FindFirstChild("Arrow_" .. i)
            if not arrow then
                arrow = Instance.new("TextLabel")
                arrow.Name = "Arrow_" .. i
                arrow.Size = UDim2.new(0, 20, 0, 20)
                arrow.AnchorPoint = Vector2.new(0.5, 0.5)
                arrow.BackgroundTransparency = 1
                arrow.Text = "➤" -- Panah menunjuk ke kanan di orientasi 0 derajat
                arrow.Font = Enum.Font.GothamBlack
                arrow.TextSize = 20
                arrow.TextStrokeTransparency = 0 -- Outline hitam agar jelas
                arrow.Parent = radarBillboard
            end
            
            -- Samakan warna panah dengan tipe telur
            if egg.Name == "Time Egg" then arrow.TextColor3 = Color3.fromRGB(85, 255, 255)
            elseif egg.Name == "Galaxy Egg" then arrow.TextColor3 = Color3.fromRGB(170, 0, 255)
            elseif egg.Name == "Phoenix Egg" then arrow.TextColor3 = Color3.fromRGB(255, 85, 0)
            else arrow.TextColor3 = Color3.fromRGB(255, 255, 0) end
            
            arrow.Position = UDim2.new(0.5, x, 0.5, y)
            arrow.Rotation = math.deg(angle)
            arrow.Visible = true
            
            i = i + 1
        end
    end
end)
table.insert(connections, renderConnection)

