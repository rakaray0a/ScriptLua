local function showNotification(eggName)
    notifCounter = notifCounter + 1
    local currentCount = notifCounter
    
    notifLabel.Text = "🥚 " .. eggName .. " Spawned!"
    notifLabel.Visible = true
    
    -- Efek Suara Ping (Dibuat di CoreGui agar selalu terdengar Client)
    local snd = Instance.new("Sound")
    snd.SoundId = "rbxassetid://4590657391" -- Sound ping universal
    snd.Volume = 2
    snd.Parent = CoreGui
    snd:Play()
    task.delay(snd.TimeLength + 1, function() snd:Destroy() end)
    
    -- Hilangkan teks setelah 3 detik
    task.delay(3, function()
        if notifCounter == currentCount then
            notifLabel.Visible = false
        end
    end)
end

