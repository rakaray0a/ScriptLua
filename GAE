-- 5. LOOP RENDER (RADAR 2D HUD & AIMBOT)
-----------------------------------
local renderConnection = RunService.RenderStepped:Connect(function()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    
    -- === RADAR 2D HUD LOGIC ===
    if radarEnabled and root then
        for _, marker in pairs(radarMarkers) do marker.Visible = false end

        local i = 1
        for egg, _ in pairs(activeEggInstances) do
            if egg.Parent and targetEggs[egg.Name] then
                local eggPos = (egg:IsA("Model") and egg.PrimaryPart and egg.PrimaryPart.Position) or (egg:IsA("BasePart") and egg.Position) or egg:GetModelCFrame().Position
                local rel = cam.CFrame:PointToObjectSpace(eggPos)
                local angle = math.atan2(rel.Z, rel.X)
                local radius = (radarHUD.AbsoluteSize.X / 2) - 15 
                local x = math.cos(angle) * radius
                local y = math.sin(angle) * radius
                
                local arrow = radarHUD:FindFirstChild("Arrow_" .. i)
                if not arrow then
                    arrow = Instance.new("TextLabel")
                    arrow.Name = "Arrow_" .. i; arrow.Size = UDim2.new(0, 20, 0, 20); arrow.AnchorPoint = Vector2.new(0.5, 0.5)
                    arrow.BackgroundTransparency = 1; arrow.Text = "➤"; arrow.Font = Enum.Font.GothamBlack
                    arrow.TextSize = 16; arrow.TextStrokeTransparency = 0; arrow.Parent = radarHUD
                    table.insert(radarMarkers, arrow)
                end
                
                if egg.Name == "Time Egg" then arrow.TextColor3 = Color3.fromRGB(85, 255, 255)
                elseif egg.Name == "Galaxy Egg" then arrow.TextColor3 = Color3.fromRGB(170, 0, 255)
                elseif egg.Name == "Phoenix Egg" then arrow.TextColor3 = Color3.fromRGB(255, 85, 0)
                else arrow.TextColor3 = Color3.fromRGB(255, 255, 0) end
                
                arrow.Position = UDim2.new(0.5, x, 0.5, y); arrow.Rotation = math.deg(angle); arrow.Visible = true
                i = i + 1
            end
        end
    end

    -- === AUTO AIMBOT LOGIC ===
    if aimActivelyLocked and root then
        local bestTarget = nil
        local shortestDist = math.huge
        local foundTimeEgg = false

        for egg, _ in pairs(activeEggInstances) do
            if egg.Parent and targetEggs[egg.Name] then
                local eggPos = (egg:IsA("Model") and egg.PrimaryPart and egg.PrimaryPart.Position) or (egg:IsA("BasePart") and egg.Position) or egg:GetModelCFrame().Position
                local dist = (root.Position - eggPos).Magnitude
                
                if egg.Name == "Time Egg" then
                    if not foundTimeEgg then bestTarget = eggPos; shortestDist = dist; foundTimeEgg = true
                    elseif dist < shortestDist then bestTarget = eggPos; shortestDist = dist end
                elseif not foundTimeEgg then
                    if dist < shortestDist then bestTarget = eggPos; shortestDist = dist end
                end
            end
        end
        if bestTarget then cam.CFrame = CFrame.new(cam.CFrame.Position, bestTarget) end
    end
end)
table.insert(connections, renderConnection)

