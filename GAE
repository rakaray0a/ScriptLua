local function saveData(fileName, dataTable)
    if writefile then pcall(function() writefile(fileName, HttpService:JSONEncode(dataTable)) end) end
end
local function loadData(fileName, targetTable)
    if readfile then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if success and type(result) == "table" then
            local count = 0
            for k, v in pairs(result) do targetTable[k] = v; count = count + 1 end
            if count > 0 then return true end
        end
    end
    return false
end

