local function showNotification(eggName)
    notifCounter = notifCounter + 1
    local currentCount = notifCounter
    local snd = Instance.new("Sound")
    snd.Parent = CoreGui
    local displayDuration = 3
    notifLabel.Visible = true

    if eggName == "Time Egg" then
        snd.SoundId = "rbxassetid://2865228021"; snd.Volume = 3
        notifLabel.Text = "🌟 URGENT: " .. eggName .. " SPAWNED! 🌟"; notifLabel.TextColor3 = Color3.fromRGB(85, 255, 255)
        displayDuration = 5
    elseif eggName == "Galaxy Egg" then
        snd.SoundId = "rbxassetid://6140502127"; snd.Volume = 2
        notifLabel.Text = "🥚 " .. eggName .. " Spawned!"; notifLabel.TextColor3 = Color3.fromRGB(170, 0, 255)
    elseif eggName == "Phoenix Egg" then
        snd.SoundId = "rbxassetid://4612382103"; snd.Volume = 2
        notifLabel.Text = "🥚 " .. eggName .. " Spawned!"; notifLabel.TextColor3 = Color3.fromRGB(255, 85, 0)
    else
        snd.SoundId = "rbxassetid://4590657391"; snd.Volume = 2
        notifLabel.Text = "🥚 " .. eggName .. " Spawned!"; notifLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    end
    
    snd:Play()
    task.delay(snd.TimeLength + 1, function() snd:Destroy() end)
    task.delay(displayDuration, function() if notifCounter == currentCount then notifLabel.Visible = false end end)
end

