local renderedEggsFolder = Workspace:WaitForChild("RenderedEggs")

local function getISOTimestamp()
	return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

-- Function Kirim ke Discord
local function sendDiscordNotification(eggName)
	local payload = {
		content = PING_TEXT ~= "" and PING_TEXT or nil,
		embeds = {
			{
				title = "🚨 ETHEREAL EGG DETECTED!",
				description = "### 🥚 **" .. eggName .. "**\n> *" .. eggName .. " Telah Spawn atau Restock di Server, Segera Login!!*",
				color = 0xFFD700,
				fields = {
					{
						name = "📦 Model Name",
						value = "`" .. eggName .. "`",
						inline = true
					},
					{
						name = "⚡ Status",
						value = "🟢 **LIVE / SPAWNED**",
						inline = true
					}
				},
				footer = {
					text = "Egg Restock Notifier System",
					icon_url = "https://cdn-icons-png.flaticon.com/512/1043/1043424.png"
				},
				timestamp = getISOTimestamp()
			}
		}
	}

	local success, response = pcall(function()
		return httpRequest({
			Url = DISCORD_WEBHOOK_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)

	if success then
		print("✨ [DISCORD] Notifikasi terkirim untuk: " .. eggName)
	else
		warn("❌ [DISCORD ERROR] Gagal mengirim webhook!")
	end
end

-- Function Kirim ke WhatsApp
local function sendWANotification(eggName)
	if not WA_ENABLE or FONNTE_TOKEN == "" then return end

	local waMessage = "🚨 *ETHEREAL EGG RESTOCK / SPAWN ALERT!*\n\n" ..
		"🥚 *Egg Name:* " .. eggName .. "\n" ..
		"📍 *Status:* Spawned di Server!\n\n" ..
		"⚡ _" .. eggName .. " Telah Spawn atau Restock di Server, Segera Login!!_"

	local payload = {
		target = WA_TARGET_NUMBER,
		message = waMessage,
		countryCode = "62" -- Wajib ada untuk memvalidasi nomor/grup Indonesia
	}

	local success, response = pcall(function()
		return httpRequest({
			Url = "https://api.fonnte.com/send",
			Method = "POST",
			Headers = {
				["Authorization"] = FONNTE_TOKEN,
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(payload)
		})
	end)

	if success and response then
		print("📱 [WHATSAPP] Respon API Fonnte: " .. tostring(response.Body))
	else
		warn("❌ [WHATSAPP ERROR] Gagal mengirim HTTP request ke Fonnte!")
	end
end

-- Main Trigger Notification
local function triggerAlert(eggName)
	task.spawn(sendDiscordNotification, eggName)
	task.spawn(sendWANotification, eggName)
	print("📢 [ALERT SENT] Discord & WhatsApp notification dispatched for: " .. eggName)
end

