local HttpService = game:GetService("HttpService")

-- Masukkan Token dari BotFather dan ID dari userinfobot di dalam tanda kutip
local BOT_TOKEN = "AAE84hqNm1ZR-KA0QhGWrqV-j3XFFnJb36Y"
local CHAT_ID = "7267868973"

-- Endpoint URL resmi dari Telegram (Bisa diakses langsung dari Roblox)
local TELEGRAM_URL = "https://api.telegram.org/bot" .. BOT_TOKEN .. "/sendMessage"

local renderedEggsFolder = workspace:WaitForChild("RenderedEggs")

local targetEggs = {
	["Volcanic Egg"] = true,
	["Cherub Egg"] = true,
	["Solaris Egg"] = true,
	["Blackhole Egg"] = true
}

local function sendTelegramNotification(eggName)
	local messageText = eggName .. " Telah Spawn atau Restock di Server, Segera Login!!"
	
	local payload = {
		chat_id = CHAT_ID,
		text = messageText
	}
	
	local success, errorMessage = pcall(function()
		local jsonData = HttpService:JSONEncode(payload)
		-- Mengirim POST request langsung ke server Telegram
		HttpService:PostAsync(TELEGRAM_URL, jsonData, Enum.HttpContentType.ApplicationJson)
	end)
	
	if not success then
		warn("Gagal mengirim notifikasi Telegram: " .. errorMessage)
	end
end

renderedEggsFolder.ChildAdded:Connect(function(child)
	task.wait(0.1) 
	
	if targetEggs[child.Name] then
		sendTelegramNotification(child.Name)
	end
end)
