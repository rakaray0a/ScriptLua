local HttpService = game:GetService("HttpService")

-- ⚠️ GANTI DENGAN TOKEN DAN CHAT ID ANDA
local BOT_TOKEN = "8842886436:AAE84hqNm1ZR-KA0QhGWrqV-j3XFFnJb36Y"
local CHAT_ID = "7267868973"

local TELEGRAM_URL = "https://api.telegram.org/bot" .. BOT_TOKEN .. "/sendMessage"

local function sendTestMessage(messageText)
	print("🔄 Sedang mencoba menghubungi Telegram...")

	local payload = {
		chat_id = CHAT_ID,
		text = messageText
	}

	local success, responseBody = pcall(function()
		local jsonData = HttpService:JSONEncode(payload)
		return HttpService:PostAsync(TELEGRAM_URL, jsonData, Enum.HttpContentType.ApplicationJson)
	end)

	if success then
		print("✅ SUKSES! Pesan tes berhasil terkirim ke Telegram.")
		print("Diterima dari Telegram: ", responseBody)
	else
		warn("❌ GAGAL MENGIRIM PESAN! Detail Error:")
		warn(responseBody)
	end
end

-- Menunggu 2 detik setelah game dimainkan, lalu langsung tes kirim pesan
