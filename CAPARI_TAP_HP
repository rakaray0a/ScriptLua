local draggingTarget = nil
local dragInput = nil
local dragStartPos = Vector2.zero
local frameStartPos = UDim2.new()

local resizing = false
local resizeInput = nil
local resizeStartPos = Vector2.zero
local resizeStartSize = Vector2.zero

local function isPointerInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isPointerMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

header.InputBegan:Connect(function(input)
	if isPointerInput(input) and not resizing then
		draggingTarget = mainFrame
		dragInput = input
		dragStartPos = input.Position
		frameStartPos = mainFrame.Position
	end
end)

miniIcon.InputBegan:Connect(function(input)
	if isPointerInput(input) then
		draggingTarget = miniIcon
		dragInput = input
		dragStartPos = input.Position
		frameStartPos = miniIcon.Position
	end
end)

resizeHandle.InputBegan:Connect(function(input)
	if isPointerInput(input) then
		resizing = true
		resizeInput = input
		resizeStartPos = input.Position
		resizeStartSize = Vector2.new(mainFrame.AbsoluteSize.X, mainFrame.AbsoluteSize.Y)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not isPointerMove(input) then return end

	if draggingTarget and input == dragInput then
		local delta = input.Position - dragStartPos
		draggingTarget.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	elseif resizing and input == resizeInput then
		local delta = input.Position - resizeStartPos
		local newW = math.clamp(resizeStartSize.X + delta.X, MIN_W, MAX_W)
		local newH = math.clamp(resizeStartSize.Y + delta.Y, MIN_H, MAX_H)
		mainFrame.Size = UDim2.fromOffset(newW, newH)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == dragInput then
		draggingTarget = nil
		dragInput = nil
	end
	if input == resizeInput then
		resizing = false
		resizeInput = nil
	end
end)

-- ==========================================
-- DETEKSI & EKSEKUSI CEPAT
-- ==========================================
local function isInsideViewport(obj)
	local camera = workspace.CurrentCamera
	local vpSize = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local pos = obj.AbsolutePosition
	local size = obj.AbsoluteSize

	if size.X < 20 or size.Y < 20 then
		return false
	end

	if size.X > vpSize.X * 0.85 and size.Y > vpSize.Y * 0.85 then
		return false
	end

	local overlapsX = (pos.X + size.X) > 0 and pos.X < vpSize.X
	local overlapsY = (pos.Y + size.Y) > 0 and pos.Y < vpSize.Y
	return overlapsX and overlapsY
end

local function isTapButtonVisible(obj)
	if not obj or not obj:IsA("GuiObject") then return false end
	if not obj.Visible then return false end
	if not isInsideViewport(obj) then return false end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		if obj.ImageTransparency >= 0.9 then
			return false
		end
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		if obj.TextTransparency >= 0.9 then
			return false
		end
	end

	local guiAncestor = obj:FindFirstAncestorOfClass("ScreenGui")
	if not guiAncestor or not guiAncestor.Enabled then
		return false
	end

	local current = obj.Parent
	while current and current ~= guiAncestor do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end

	return true
end

local function tryFireSignal(button)
	if typeof(firesignal) == "function" then
		for _, sigName in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
			local ok, sig = pcall(function()
				return button[sigName]
			end)
			if ok and sig then
				pcall(firesignal, sig)
			end
		end
	end
end

local function pressNow(obj)
	local now = os.clock()
	if (now - lastGlobalFire) < GLOBAL_COOLDOWN then
		return
	end

	local prevObjTime = lastObjectFire[obj]
	if prevObjTime and (now - prevObjTime) < PER_OBJECT_COOLDOWN then
		return
	end

	lastGlobalFire = now
	lastObjectFire[obj] = now

	if obj:IsA("GuiButton") then
		tryFireSignal(obj)
	end

	local ok, err = pcall(function()
		trainTapRemote:FireServer()
	end)

	if ok then
		local p = obj.AbsolutePosition
		setStatus(string.format("Tap @ (%d, %d) [%s]", math.floor(p.X), math.floor(p.Y), obj.Name))
	else
		setStatus("Error: " .. tostring(err))
	end
end

local lastSeenPosMap = setmetatable({}, { __mode = "k" })
local wasVisibleMap = setmetatable({}, { __mode = "k" })

RunService.Heartbeat:Connect(function()
	if not autoTapEnabled then return end

	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and (gui.Name == "TrainTap" or gui.Name == "TrainTapEdge") and gui.Enabled then
			for _, desc in ipairs(gui:GetDescendants()) do
				if desc:IsA("GuiObject") then
					local visibleNow = isTapButtonVisible(desc)
					local wasVisible = wasVisibleMap[desc] == true
					local curPos = desc.AbsolutePosition
					local prevPos = lastSeenPosMap[desc]
					local movedSignificantly = prevPos and ((curPos - prevPos).Magnitude > 8)

					if visibleNow then
						if (not wasVisible) or movedSignificantly then
							wasVisibleMap[desc] = true
							lastSeenPosMap[desc] = curPos
							pressNow(desc)
						end
					else
						wasVisibleMap[desc] = false
						lastSeenPosMap[desc] = nil
					end
				end
			end
		end
	end
end)
