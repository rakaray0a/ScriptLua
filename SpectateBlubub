--- LOGIC: DRAGGING & RESIZING WINDOW ---
local dragging, dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end
end)

local resizing, resizeStart, startSize

resizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		resizeStart = input.Position
		startSize = mainFrame.AbsoluteSize
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				resizing = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - resizeStart
		local newWidth = math.clamp(startSize.X + delta.X, 240, 500)
		local newHeight = math.clamp(startSize.Y + delta.Y, 200, 400)
		mainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
	end
end)

--- LOGIC: MINIMIZE / MAXIMIZE ---
local isMinimized = false
minimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	dropdownList.Visible = false
	if isMinimized then
		minimizeBtn.Text = "+"
		contentFrame.Visible = false
		resizeHandle.Visible = false
		mainFrame.Size = UDim2.new(0, mainFrame.AbsoluteSize.X, 0, 35)
	else
		minimizeBtn.Text = "-"
		contentFrame.Visible = true
		resizeHandle.Visible = true
		mainFrame.Size = UDim2.new(0, mainFrame.AbsoluteSize.X, 0, 240)
	end
end)

--- LOGIC: ZOOM FUNCTIONS ---
local function updateZoom(amount)
	currentZoom = math.clamp(currentZoom + amount, minZoom, maxZoom)
	zoomLabel.Text = "Zoom: " .. math.floor(currentZoom)
end

UserInputService.InputChanged:Connect(function(input)
	if isSpectating and input.UserInputType == Enum.UserInputType.MouseWheel then
		updateZoom(-input.Position.Z * 2)
	end
end)

zoomInBtn.MouseButton1Click:Connect(function() updateZoom(-2) end)
zoomOutBtn.MouseButton1Click:Connect(function() updateZoom(2) end)

--- LOGIC: SPECTATE MAIN LOOP ---
toggleBtn.MouseButton1Click:Connect(function()
	isSpectating = not isSpectating
	dropdownList.Visible = false
	
	if isSpectating then
		toggleBtn.Text = "SPECTATE: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
		originalCameraType = camera.CameraType
		originalSubject = camera.CameraSubject
		
		camera.CameraType = Enum.CameraType.Scriptable
		
		spectateConnection = RunService.RenderStepped:Connect(function()
			local targetPlayer = Players:FindFirstChild(TARGET_USERNAME)
			local targetChar = targetPlayer and targetPlayer.Character
			
			if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
				statusLabel.Text = "Status: Menonton " .. TARGET_USERNAME
				
				local targetHRP = targetChar.HumanoidRootPart
				local camPosition = targetHRP.Position - (targetHRP.CFrame.LookVector * currentZoom) + Vector3.new(0, 3, 0)
				camera.CFrame = CFrame.new(camPosition, targetHRP.Position + Vector3.new(0, 2, 0))
				
				local currentTime = tick()
				if currentTime - lastStreamTick > 0.5 then
					lastStreamTick = currentTime
					pcall(function()
						localPlayer:RequestStreamAroundAsync(targetHRP.Position)
					end)
				end
			else
				statusLabel.Text = "Target tidak ditemukan / keluar server!"
			end
		end)
	else
		toggleBtn.Text = "SPECTATE: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		statusLabel.Text = "Spectate dimatikan."
		
		if spectateConnection then
			spectateConnection:Disconnect()
			spectateConnection = nil
		end
		
		camera.CameraType = originalCameraType
		local localChar = localPlayer.Character
		if localChar and localChar:FindFirstChildOfClass("Humanoid") then
			camera.CameraSubject = localChar:FindFirstChildOfClass("Humanoid")
		else
			camera.CameraSubject = originalSubject
		end
	end
end)
