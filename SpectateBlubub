--- LOGIC: POPULATE PLAYER DROPDOWN ---
local function updatePlayerList()
	for _, child in pairs(dropdownList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, 0, 0, 28)
			pBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
			pBtn.BorderSizePixel = 0
			pBtn.Font = Enum.Font.Gotham
			pBtn.Text = player.Name
			pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
			pBtn.TextSize = 12
			pBtn.Parent = dropdownList
			
			pBtn.MouseButton1Click:Connect(function()
				selectedTargetPlayer = player
				TARGET_USERNAME = player.Name
				dropdownBtn.Text = "Target: " .. TARGET_USERNAME
				dropdownList.Visible = false
			end)
		end
	end
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
updatePlayerList()

