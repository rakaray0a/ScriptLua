-- ==========================================
-- LOGIKA SERVER HOP & TANDAI RIWAYAT SERVER
-- ==========================================
local function loadServerList()
    for _, child in ipairs(serverScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local success, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success and result and result.data then
        local yPos = 0
        for _, server in ipairs(result.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                local isJoined = table.find(getgenv().JoinedServersList, server.id) ~= nil
                
                local sButton = Instance.new("TextButton")
                sButton.Size = UDim2.new(1, -5, 0, 35)
                sButton.BackgroundColor3 = isJoined and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(40, 40, 40)
                sButton.TextColor3 = isJoined and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(255, 255, 255)
                
                local statusText = isJoined and " [Sudah Dijoinkan]" or ""
                sButton.Text = " Pemain: " .. server.playing .. "/" .. server.maxPlayers .. statusText
                sButton.Font = Enum.Font.SourceSans
                sButton.TextSize = 13
                sButton.TextXAlignment = Enum.TextXAlignment.Left
                sButton.Parent = serverScroll
                
                local sCorner = Instance.new("UICorner")
                sCorner.CornerRadius = UDim.new(0, 4)
                sCorner.Parent = sButton
                
                sButton.MouseButton1Click:Connect(function()
                    if not table.find(getgenv().JoinedServersList, server.id) then
                        table.insert(getgenv().JoinedServersList, server.id)
                    end
                    sButton.Text = " Menghubungkan..."
                    sButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
                    
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, localPlayer)
                end)
                
                yPos = yPos + 40
            end
        end
        serverScroll.CanvasSize = UDim2.new(0, 0, 0, yPos)
    else
        local errLabel = Instance.new("TextLabel")
        errLabel.Size = UDim2.new(1, 0, 0, 30)
        errLabel.BackgroundTransparency = 1
        errLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        errLabel.Text = "Gagal memuat daftar server!"
        errLabel.Font = Enum.Font.SourceSans
        errLabel.TextSize = 13
        errLabel.Parent = serverScroll
    end
end

refreshButton.MouseButton1Click:Connect(function()
    loadServerList()
end)

loadServerList()
