        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local jarakTerdekat = math.huge
            local targetTerbaik = nil

            -- Mengumpulkan semua target dari kedua folder (Serangga Biasa & BosDunia)
            local semuaMusuh = {}
            if folderSerangga then 
                for _, v in ipairs(folderSerangga:GetChildren()) do table.insert(semuaMusuh, v) end 
            end
            if folderBos then 
                for _, v in ipairs(folderBos:GetChildren()) do table.insert(semuaMusuh, v) end 
            end

            for _, musuh in ipairs(semuaMusuh) do
                if Config.TargetPilihan == "Semua Target" or musuh.Name == Config.TargetPilihan then
                    local rootPart = musuh:FindFirstChild("Root")
                    if rootPart then
                        local jarak = (hrp.Position - rootPart.Position).Magnitude
                        if jarak < jarakTerdekat then jarakTerdekat = jarak; targetTerbaik = musuh end
                    end
                end
            end

            if targetTerbaik then
                local targetRoot = targetTerbaik:FindFirstChild("Root")
                if targetRoot then
                    hrp.CFrame = targetRoot.CFrame * CFrame.new(0, Config.JarakTinggi, Config.JarakBelakang)
                    local senjata = equipSenjata()
                    if senjata then
                        local baseDelay = 0.6
                        local clickInterval = Config.FastAttackAktif and (baseDelay / Config.FastAttackSpeed) or baseDelay
                        if tick() - lastClick >= clickInterval then
                            lastClick = tick()
                            ClickScreen()
                            pcall(function() senjata:Activate() end)
                        end
                    end
                end
            end
        end
    end
end)

