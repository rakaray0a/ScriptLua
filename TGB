local function UpdateTargetList(filterText)
    filterText = filterText and string.lower(filterText) or ""
    for _, child in pairs(TargetScroll:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end

    local uniqueTargets = {["Semua Target"] = "Universal"}
    
    -- Memasukkan Serangga
    if folderSerangga then 
        for _, serangga in ipairs(folderSerangga:GetChildren()) do uniqueTargets[serangga.Name] = "Monster" end 
    end
    -- Memasukkan Boss (NagaSerangga dan lainnya di folder BosDunia)
    if folderBos then 
        for _, boss in ipairs(folderBos:GetChildren()) do uniqueTargets[boss.Name] = "Boss" end 
    end

    local sortedTargets = {}
    for name, _ in pairs(uniqueTargets) do if filterText == "" or string.find(string.lower(name), filterText) then table.insert(sortedTargets, name) end end
    table.sort(sortedTargets)

    local ySize = 0
    for _, tName in ipairs(sortedTargets) do
        local isSelected = (Config.TargetPilihan == tName)
        local isBoss = (uniqueTargets[tName] == "Boss")
        
        local btn = Instance.new("TextButton", TargetScroll); btn.Size = UDim2.new(1, -10, 0, 35); btn.Position = UDim2.new(0, 5, 0, 0); btn.BackgroundColor3 = isSelected and Color3.fromRGB(40, 70, 110) or Color3.fromRGB(35, 35, 45); btn.Text = ""; btn.AutoButtonColor = false; Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        
        if isSelected then local stroke = Instance.new("UIStroke", btn); stroke.Color = Color3.fromRGB(0, 200, 255); stroke.Thickness = 1.5 end
        
        -- Custom Tampilan UI Khusus Boss
        local textLabel = Instance.new("TextLabel", btn); textLabel.Size = UDim2.new(1, 0, 1, 0); textLabel.BackgroundTransparency = 1
        local iconPrefix = isBoss and "👹 " or ""
        local selectedPrefix = isSelected and "⚡ " or ""
        
        textLabel.Text = selectedPrefix .. iconPrefix .. tName
        
        -- Pewarnaan Text (Boss jadi merah terang agar beda)
        if isBoss then
            textLabel.TextColor3 = isSelected and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(255, 50, 50)
        else
            textLabel.TextColor3 = isSelected and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(200, 200, 200)
        end
        
        textLabel.Font = isSelected and Enum.Font.GothamBold or Enum.Font.GothamSemibold; textLabel.TextSize = 13; textLabel.TextXAlignment = Enum.TextXAlignment.Left
        local padding = Instance.new("UIPadding", textLabel); padding.PaddingLeft = UDim.new(0, 12)
        
        btn.MouseEnter:Connect(function() if not isSelected then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play() end end)
        btn.MouseLeave:Connect(function() if not isSelected then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play() end end)
        
        btn.MouseButton1Click:Connect(function() Config.TargetPilihan = tName; SaveConfig(); UpdateTargetList(SearchBox.Text) end)
        ySize = ySize + 39
    end
    TargetScroll.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

