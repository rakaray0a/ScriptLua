    local ValLabel = Instance.new("TextLabel", parent); ValLabel.Size = UDim2.new(0, 40, 0, 30); ValLabel.Position = UDim2.new(0.68, 0, 0, yPos); ValLabel.BackgroundTransparency = 1; ValLabel.Text = tostring(Config[configKey]); ValLabel.TextColor3 = Color3.new(1,1,1); ValLabel.Font = Enum.Font.GothamBold
