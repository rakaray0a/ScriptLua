local function equipSenjata()
    local char = player.Character
    if not char then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    local alat = player.Backpack:FindFirstChild(namaSenjata) or char:FindFirstChild(namaSenjata)
    if humanoid and alat and alat.Parent == player.Backpack then humanoid:EquipTool(alat) end
    return alat
end

local function SetupAnimationHook(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        local animator = hum:WaitForChild("Animator", 5)
        if animator then animator.AnimationPlayed:Connect(function(track) if Config.FastAttackAktif then track:AdjustSpeed(Config.FastAttackSpeed) end end) end
    end
end
