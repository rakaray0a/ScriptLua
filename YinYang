--// 3. FUNGSI PEMICU PROXIMITYPROMPT MULTI-METHOD
----------------------------------------------------------------
local function firePromptCustom(prompt)
	if not prompt then return end
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt, 0)
			fireproximityprompt(prompt, prompt.HoldDuration or 0)
		end
		prompt:InputHoldBegin()
		local duration = prompt.HoldDuration > 0 and prompt.HoldDuration or 0.2
		task.wait(duration + 0.05)
		prompt:InputHoldEnd()
		if prompt.Enabled then prompt:Trigger() end
	end)
end

local function triggerAutoPickup(model)
	if not model then return end
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			firePromptCustom(desc)
		end
	end
end

----------------------------------------------------------------
--// 4. LOGIKA SEKUENSIL RITUAL (SEAL -> REWARDS -> DROPOFF -> LOOP)
----------------------------------------------------------------
local function safeTeleport(cframe)
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if rootPart then
		rootPart.CFrame = cframe
		pcall(function()
			local tween = TweenService:Create(rootPart, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {CFrame = cframe})
			tween:Play()
		end)
	end
end

local function processSealAndRewards()
	if ScriptState.isRitualInProgress then return end
	ScriptState.isRitualInProgress = true

	task.spawn(function()
		local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
		local sealModel = headlessRitual and headlessRitual:FindFirstChild("Seal")
		
		if sealModel then
			statusTextLabel.Text = "🔮 Teleporting ke Seal..."
			local sealPart = sealModel:FindFirstChildWhichIsA("BasePart", true) or sealModel
			local targetCFrame = (sealPart:IsA("BasePart") and sealPart.CFrame or CFrame.new()) * CFrame.new(0, 1, 3)
			
			-- 1. Teleport ke Model Seal
			safeTeleport(targetCFrame)
			ScriptState.lastTargetModel = sealPart
			task.wait(0.5)

			-- 2. Mencari & Menekan KEDUA input di Seal secara bergantian satu per satu
			statusTextLabel.Text = "⚡ Meletakkan Yin & Yang di Seal (1 per 1)..."
			local sealPrompts = {}
			for _, desc in ipairs(sealModel:GetDescendants()) do
				if desc:IsA("ProximityPrompt") then
					table.insert(sealPrompts, desc)
				end
			end

			-- Eksekusi satu per satu dengan jeda aman agar tidak berbenturan
			for _, prompt in ipairs(sealPrompts) do
				firePromptCustom(prompt)
				task.wait(1.5) -- Jeda aman untuk menekan input berikutnya
			end

			task.wait(1)

			-- 3. Teleport langsung ke Folder yang Mengandung kata "Rewards" di Runtime
			local runtimeFolder = headlessRitual:FindFirstChild("Runtime")
			if runtimeFolder then
				local rewardsFolder = nil
				-- Tunggu sebentar sampai folder Rewards dimuat oleh game
				for i = 1, 10 do
					for _, child in ipairs(runtimeFolder:GetChildren()) do
						if child:IsA("Folder") and string.find(child.Name, "Rewards") then
							rewardsFolder = child
							break
						end
					end
					if rewardsFolder then break end
					task.wait(0.3)
				end

				if rewardsFolder then
					statusTextLabel.Text = "🎁 Auto-Pickup Rewards di Goa..."
					
					-- Kumpulkan seluruh item di folder Rewards
					local itemsToCollect = {}
					for _, child in ipairs(rewardsFolder:GetChildren()) do
						table.insert(itemsToCollect, child)
					end

					-- Teleport dan tekan prompt pada setiap item reward secara berurutan
					for _, item in ipairs(itemsToCollect) do
						local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
						if part then
							safeTeleport(part.CFrame * CFrame.new(0, 1, 1.5))
							ScriptState.lastTargetModel = part
							task.wait(0.2)
						end
						triggerAutoPickup(item)
						task.wait(0.6)
					end
				end
			end

			-- 4. Teleport ke Workspace.CandyDropOff.Pad
			statusTextLabel.Text = "🏃 Teleporting ke Candy DropOff..."
			local dropOff = Workspace:FindFirstChild("CandyDropOff")
			local pad = dropOff and dropOff:FindFirstChild("Pad")
			if pad then
				local padPart = pad:IsA("BasePart") and pad or pad:FindFirstChildWhichIsA("BasePart", true)
				if padPart then
					safeTeleport(padPart.CFrame * CFrame.new(0, 2, 0))
					statusTextLabel.Text = "✅ Ritual Selesai! Menunggu Spawn Berikutnya..."
				end
			end
		end

		-- Reset Status untuk Looping Berikutnya
		ScriptState.collectedCount = 0
		ScriptState.lastTargetModel = nil
		ScriptState.isRitualInProgress = false
	end)
end

----------------------------------------------------------------
--// 5. LOGIKA ESP & AUTO-TELEPORT (SKIP IF FAIL -> TELEPORT TO SEAL)
----------------------------------------------------------------
local function performAutoTeleport(model)
	if not ScriptState.autoCollectEnabled or ScriptState.isRitualInProgress then return end
	if not model or not model.Parent then return end

	task.spawn(function()
		local targetPart = nil
		for i = 1, 15 do
			targetPart = model:FindFirstChildWhichIsA("BasePart", true)
			if targetPart then break end
			task.wait(0.05)
		end

		local char = player.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")

		if rootPart and targetPart then
			safeTeleport(targetPart.CFrame * CFrame.new(0, 1, 1.5))
			ScriptState.lastTargetModel = targetPart

			local pickedUpSuccess = false
			-- Coba pickup beberapa kali
			for i = 1, 6 do
				if not model or not model.Parent then 
					pickedUpSuccess = true
					break 
				end
				triggerAutoPickup(model)
				task.wait(0.15)
			end

			-- Jika item berhasil hilang (ter-pickup) atau gagal (tidak bisa dipickup), tambah counter
			ScriptState.collectedCount = ScriptState.collectedCount + 1

			-- Jika sudah memproses 2 item (Yin & Yang) atau item terakhir di map, langsung teleport ke Seal
			if ScriptState.collectedCount >= 2 or not pickedUpSuccess then
				processSealAndRewards()
			end
		end
	end)
end

local function updateNotificationText()
	local yinStatus = ScriptState.spawnedStatus.Yin and "🟢 SPAWN" or "🔴 BELUM ADA"
	local yangStatus = ScriptState.spawnedStatus.Yang and "🟢 SPAWN" or "🔴 BELUM ADA"
	
	if not ScriptState.isRitualInProgress then
		statusTextLabel.Text = string.format("☯️ STATUS RITUAL:\n• Yin: %s\n• Yang: %s", yinStatus, yangStatus)
	end
end

local function checkStatusRealtime()
	local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
	local runtimeFolder = headlessRitual and headlessRitual:FindFirstChild("Runtime")
	local hasYin, hasYang = false, false
	
	if runtimeFolder then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			if child.Name == "Yin" then hasYin = true end
			if child.Name == "Yang" then hasYang = true end
		end
	end

	ScriptState.spawnedStatus.Yin = hasYin
	ScriptState.spawnedStatus.Yang = hasYang
	updateNotificationText()
end

local function removeESP(model)
	if ScriptState.activeHighlights[model] then
		pcall(function() ScriptState.activeHighlights[model]:Destroy() end)
		ScriptState.activeHighlights[model] = nil
	end
	if ScriptState.activeBillboards[model] then
		pcall(function() ScriptState.activeBillboards[model].Gui:Destroy() end)
		ScriptState.activeBillboards[model] = nil
	end
	if ScriptState.trackedModels[model] then
		for _, conn in ipairs(ScriptState.trackedModels[model]) do
			pcall(function() conn:Disconnect() end)
		end
		ScriptState.trackedModels[model] = nil
	end
	checkStatusRealtime()
end

local function createESP(model)
	if not model or not model:IsA("Model") then return end
	
	performAutoTeleport(model)

	if ScriptState.activeHighlights[model] then return end

	local modelName = model.Name
	local espColor = Color3.fromRGB(255, 255, 255)
	
	if modelName == "Yin" then
		espColor = Color3.fromRGB(100, 180, 255)
	elseif modelName == "Yang" then
		espColor = Color3.fromRGB(255, 200, 50)
	else
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESPHighlight"
	highlight.Adornee = model
	highlight.FillColor = espColor
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = model
	ScriptState.activeHighlights[model] = highlight

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESPBillboard"
	billboard.Adornee = model:FindFirstChildWhichIsA("BasePart") or model
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 14
	textLabel.TextColor3 = espColor
	textLabel.TextStrokeTransparency = 0.3
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard

	billboard.Parent = model
	ScriptState.activeBillboards[model] = {Gui = billboard, Text = textLabel, Model = model}

	ScriptState.trackedModels[model] = {}
	
	local connAncestry = model.AncestryChanged:Connect(function(_, parent)
		local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
		local runtimeFolder = headlessRitual and headlessRitual:FindFirstChild("Runtime")
		if not parent or (runtimeFolder and not model:IsDescendantOf(runtimeFolder)) then
			removeESP(model)
		end
	end)

	table.insert(ScriptState.trackedModels[model], connAncestry)
	checkStatusRealtime()
end

local function scanRuntime()
	local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
	local runtimeFolder = headlessRitual and headlessRitual:FindFirstChild("Runtime")
	if not runtimeFolder then return end
	
	for _, child in ipairs(runtimeFolder:GetChildren()) do
		if child.Name == "Yin" or child.Name == "Yang" then
			performAutoTeleport(child)
			if ScriptState.espEnabled then
				createESP(child)
			end
		end
	end
	checkStatusRealtime()
end

-- Monitor Runtime Loop (Mendeteksi Spawn/Despawn berulang)
task.spawn(function()
	local activeThread = true
	table.insert(ScriptState.Connections, {
		Connected = true,
		Disconnect = function() activeThread = false end
	})

	while activeThread do
		task.wait(0.5)
		local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
		local runtimeFolder = headlessRitual and headlessRitual:FindFirstChild("Runtime")
		
		if runtimeFolder then
			checkStatusRealtime()
			if not runtimeFolder:FindFirstChild("_Connected_" .. SCRIPT_ID) then
				local marker = Instance.new("Folder")
				marker.Name = "_Connected_" .. SCRIPT_ID
				marker.Parent = runtimeFolder

				table.insert(ScriptState.Connections, runtimeFolder.ChildAdded:Connect(function(child)
					task.wait(0.02)
					if child.Name == "Yin" or child.Name == "Yang" then
						performAutoTeleport(child)
						if ScriptState.espEnabled then
							createESP(child)
						end
						checkStatusRealtime()
					end
				end))

				table.insert(ScriptState.Connections, runtimeFolder.ChildRemoved:Connect(function(child)
					removeESP(child)
				end))
			end
		end
	end
end)

