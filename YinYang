--// 4. LOGIKA ESP & AUTO-REFRESH SENSING
----------------------------------------------------------------
local function getRuntimeFolder()
	local ritual = Workspace:FindFirstChild("HeadlessRitual")
	if ritual then
		return ritual:FindFirstChild("Runtime")
	end
	return nil
end

local function checkStatusRealtime()
	local runtimeFolder = getRuntimeFolder()
	local hasYin, hasYang = false, false
	
	if runtimeFolder then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			if child.Name == "Yin" then hasYin = true end
			if child.Name == "Yang" then hasYang = true end
		end
	end
	
	ScriptState.spawnedStatus.Yin = hasYin
	ScriptState.spawnedStatus.Yang = hasYang
	updateNotificationText()
end

local function removeESP(model)
	if ScriptState.activeHighlights[model] then
		pcall(function() ScriptState.activeHighlights[model]:Destroy() end)
		ScriptState.activeHighlights[model] = nil
	end
	if ScriptState.activeBillboards[model] then
		pcall(function() ScriptState.activeBillboards[model].Gui:Destroy() end)
		ScriptState.activeBillboards[model] = nil
	end
	if ScriptState.trackedModels[model] then
		for _, conn in ipairs(ScriptState.trackedModels[model]) do
			pcall(function() conn:Disconnect() end)
		end
		ScriptState.trackedModels[model] = nil
	end
	checkStatusRealtime()
end

local function clearAllESP()
	for model, _ in pairs(ScriptState.activeHighlights) do
		removeESP(model)
	end
end

local function createESP(model)
	if not model or not model:IsA("Model") then return end
	if ScriptState.activeHighlights[model] then return end

	local modelName = model.Name
	local espColor = Color3.fromRGB(255, 255, 255)
	
	if modelName == "Yin" then
		espColor = Color3.fromRGB(100, 180, 255)
	elseif modelName == "Yang" then
		espColor = Color3.fromRGB(255, 200, 50)
	else
		return
	end

	-- Highlight (Outline 3D)
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESPHighlight"
	highlight.Adornee = model
	highlight.FillColor = espColor
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = model
	ScriptState.activeHighlights[model] = highlight

	-- BillboardGui (Teks & Jarak)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESPBillboard"
	billboard.Adornee = model:FindFirstChildWhichIsA("BasePart") or model
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 14
	textLabel.TextColor3 = espColor
	textLabel.TextStrokeTransparency = 0.3
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard

	billboard.Parent = model
	ScriptState.activeBillboards[model] = {Gui = billboard, Text = textLabel, Model = model}

	-- Pelacakan status ketika model diambil/hilang
	ScriptState.trackedModels[model] = {}
	
	local connAncestry = model.AncestryChanged:Connect(function(_, parent)
		local runtimeFolder = getRuntimeFolder()
		if not parent or (runtimeFolder and not model:IsDescendantOf(runtimeFolder)) then
			removeESP(model)
		end
	end)
	
	local connDestroying = model.Destroying:Connect(function()
		removeESP(model)
	end)

	table.insert(ScriptState.trackedModels[model], connAncestry)
	table.insert(ScriptState.trackedModels[model], connDestroying)

	checkStatusRealtime()
end

local function scanRuntime()
	local runtimeFolder = getRuntimeFolder()
	if not runtimeFolder then return end
	
	for _, child in ipairs(runtimeFolder:GetChildren()) do
		if child.Name == "Yin" or child.Name == "Yang" then
			if ScriptState.espEnabled then
				createESP(child)
			end
		end
	end
	checkStatusRealtime()
end

-- Monitor Folder Runtime untuk Spawn & Despawn Otomatis
task.spawn(function()
	local activeThread = true
	table.insert(ScriptState.Connections, {
		Connected = true,
		Disconnect = function() activeThread = false end
	})

	while activeThread do
		task.wait(0.5)
		local runtimeFolder = getRuntimeFolder()
		if runtimeFolder then
			checkStatusRealtime()
			if not runtimeFolder:FindFirstChild("_Connected_" .. SCRIPT_ID) then
				local marker = Instance.new("Folder")
				marker.Name = "_Connected_" .. SCRIPT_ID
				marker.Parent = runtimeFolder

				table.insert(ScriptState.Connections, runtimeFolder.ChildAdded:Connect(function(child)
					task.wait(0.1)
					if child.Name == "Yin" or child.Name == "Yang" then
						if ScriptState.espEnabled then
							createESP(child)
						end
						checkStatusRealtime()
					end
				end))

				table.insert(ScriptState.Connections, runtimeFolder.ChildRemoved:Connect(function(child)
					removeESP(child)
				end))
			end
		end
	end
end)

-- Toggle Button ESP
table.insert(ScriptState.Connections, toggleBtn.MouseButton1Click:Connect(function()
	ScriptState.espEnabled = not ScriptState.espEnabled
	if ScriptState.espEnabled then
		toggleBtn.Text = "ESP: ON"
		toggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		scanRuntime()
	else
		toggleBtn.Text = "ESP: OFF"
		toggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
		clearAllESP()
	end
end))

-- Update RenderStepped Real-Time Jarak & Sanity Check
table.insert(ScriptState.Connections, RunService.RenderStepped:Connect(function()
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")

	for model, data in pairs(ScriptState.activeBillboards) do
		local runtimeFolder = getRuntimeFolder()
		if not model or not model.Parent or (runtimeFolder and not model:IsDescendantOf(runtimeFolder)) then
			removeESP(model)
		elseif ScriptState.espEnabled and rootPart then
			local targetPart = model:FindFirstChildWhichIsA("BasePart")
			if targetPart then
				local distance = math.floor((targetPart.Position - rootPart.Position).Magnitude)
				data.Text.Text = "[" .. model.Name .. "]\n[" .. distance .. "m]"
			end
		end
	end
end))
