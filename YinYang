----------------------------------------------------------------
--// FUNSI CLEANUP TOTAL (Bisa di-Execute Berulang Kali)
----------------------------------------------------------------
function ScriptState.Cleanup()
	for _, conn in ipairs(ScriptState.Connections) do
		if conn and conn.Connected then
			pcall(function() conn:Disconnect() end)
		end
	end
	table.clear(ScriptState.Connections)

	for model, _ in pairs(ScriptState.trackedModels) do
		if ScriptState.trackedModels[model] then
			for _, conn in ipairs(ScriptState.trackedModels[model]) do
				pcall(function() conn:Disconnect() end)
			end
		end
	end
	table.clear(ScriptState.trackedModels)

	for _, highlight in pairs(ScriptState.activeHighlights) do
		if highlight and highlight.Parent then
			pcall(function() highlight:Destroy() end)
		end
	end
	table.clear(ScriptState.activeHighlights)

	for _, billboardData in pairs(ScriptState.activeBillboards) do
		if billboardData and billboardData.Gui and billboardData.Gui.Parent then
			pcall(function() billboardData.Gui:Destroy() end)
		end
	end
	table.clear(ScriptState.activeBillboards)

	local oldGui = playerGui:FindFirstChild("ESPRitualGui")
	if oldGui then
		oldGui:Destroy()
	end
end

_G[SCRIPT_ID] = ScriptState

