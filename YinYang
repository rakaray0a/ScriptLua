-- RenderStepped Distance & Camera Lock
table.insert(ScriptState.Connections, RunService.RenderStepped:Connect(function()
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")

	-- Camera Lock ke arah target aktif (Item/Seal/Rewards)
	if ScriptState.autoCollectEnabled and ScriptState.lastTargetModel and ScriptState.lastTargetModel.Parent then
		pcall(function()
			local targetPos = ScriptState.lastTargetModel.Position
			camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
		end)
	end

	for model, data in pairs(ScriptState.activeBillboards) do
		local headlessRitual = Workspace:FindFirstChild("HeadlessRitual")
		local runtimeFolder = headlessRitual and headlessRitual:FindFirstChild("Runtime")
		if not model or not model.Parent or (runtimeFolder and not model:IsDescendantOf(runtimeFolder)) then
			removeESP(model)
		elseif ScriptState.espEnabled and rootPart then
			local targetPart = model:FindFirstChildWhichIsA("BasePart")
			if targetPart then
				local distance = math.floor((targetPart.Position - rootPart.Position).Magnitude)
				data.Text.Text = "[" .. model.Name .. "]\n[" .. distance .. "m]"
			end
		end
	end
end))
