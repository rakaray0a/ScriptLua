-- Resize Handler untuk Panel Notifikasi
local draggingResizeNotif = false
local startMousePosNotif, startSizeNotif

table.insert(ScriptState.Connections, notifResizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingResizeNotif = true
		startMousePosNotif = input.Position
		startSizeNotif = notifFrame.AbsoluteSize
	end
end))

table.insert(ScriptState.Connections, UserInputService.InputChanged:Connect(function(input)
	if draggingResizeNotif and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - startMousePosNotif
		local newX = math.clamp(startSizeNotif.X + delta.X, 220, 450)
		local newY = math.clamp(startSizeNotif.Y + delta.Y, 70, 250)
		notifFrame.Size = UDim2.new(0, newX, 0, newY)
	end
end))

table.insert(ScriptState.Connections, UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingResizeNotif = false
	end
end))

